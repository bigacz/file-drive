generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  files    File[]
}

model File {
  id       Int     @id @default(autoincrement())
  ownerId  Int
  owner    User    @relation(fields: [ownerId], references: [id])
  folder   String?
  filename String
}
