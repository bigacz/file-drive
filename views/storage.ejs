<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload your file</title>
</head>

<body>
  <%- include('./components/navbar') %>

  <aside>
    <div><a href="./storage"> / </a></div>
    <% locals.folderNames.forEach((folder) => { %>
    <div><a href="<%=`?folder=${folder}`%>"><%= folder %></a></div>
    <% }) %>
  </aside>


  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Folder</th>
        <th>Uploaded</th>
      </tr>
    </thead>
    <tbody>

    </tbody>
    <% if(locals.files) { %>
    <% locals.files.forEach((file) => { %>
    <tr>
      <td><%= file.filename %></td>
      <td><%= file.folder %></td>
      <td><%= (file.uploadedAt).toLocaleString() %></td>
    </tr>
    <% }) %>
    <% } else { %>
    <p>You haven't uploaded any files yet!</p>
    <% } %>
  </table>

  <form action="/storage" method="POST" enctype="multipart/form-data">
    <input type="file" name="file">
    <button type="submit">Send</button>
  </form>

</body>

</html>