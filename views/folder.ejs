<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload your file</title>
</head>

<body>
  <%- include('./components/navbar') %>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Uploaded</th>
      </tr>
    </thead>
    <tbody>

    </tbody>
    <% if(locals.currentFolder.childFolders) { %>
    <% locals.currentFolder.childFolders.forEach((folder) => { %>
    <tr>
      <td><a href="<%= `?path=${locals.currentPath}/${folder.folderName}` %>"><%= folder.folderName %></a></td>
      <td> Folder </td>
    </tr>
    <% }) %>
    <% } %>


    <% if(locals.currentFolder.files) { %>
    <% locals.currentFolder.files.forEach((file) => { %>
    <tr>
      <td><%= file.filename %></td>
      <td> File </td>
      <td><%= (file.uploadedAt).toLocaleString() %></td>
    </tr>
    <% }) %>
    <% } %>

  </table>

  <form action="/file?path=<%=locals.currentFolder%>" method="POST" enctype="multipart/form-data">
    <input type="file" name="file">
    <button type="submit">Send</button>
  </form>

</body>

</html>